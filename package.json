    "level-viewer:typecheck": "tsc --noEmit -p tools/level-viewer"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
